---
// "Why not just call an LLM?": the same yes/no question asked both ways.
// The first row shows the two replies: an example of what a general LLM
// with structured output writes back, and the answer lines from the
// triage-check recording above. Four short rows under them say what each
// reply costs you. A real <table> on desktop; below 720px the replies stack
// and each later row keeps its two cells side by side under the row's label.
// decide's column carries the answer color, cyan, as the CLI does. The
// claims come from the mechanism, not from a benchmark.
//
// The LLM reply is an example, and says so. Its cells stay fair: logprobs
// are named, and the comparison is with structured output, not with chat.
//
// Prices are public, with their sources in the footnote:
//   Jev: $0.042 per million input tokens, output free
//     https://docs.typesafe.ai/models
//   gemini-decision-1: $0.10 per million input tokens, no output tokens
//     https://aistudio.google.com/docs/pricing
//   Lowest standard chat output price listed: $0.40 per million, gpt-5-nano
//     https://developers.openai.com/api/docs/pricing
//     (Batch and Flex list $0.20; the note says "standard".)
// No output-cost claim is made for OpenAI's Decisions API or Cloudflare.
import Doodle from './Doodle.astro';

const llmReply = `{
  "ready": false,
  "confidence": 0.9,
  "reason": "The issue says checkout
    feels slow, but gives no steps,
    numbers or scope to work from."
}`;

const rows: { k: string; llm: string; decide: string; note?: boolean }[] = [
	{ k: 'You pay for', llm: 'Your prompt, plus every token of that reply', decide: 'Your prompt. On Jev that is $0.042 per million tokens, and the answer is free', note: true },
	{ k: 'You wait for', llm: 'The reply to be written, a token at a time', decide: 'One answer. Nothing is written' },
	{ k: 'You handle', llm: 'JSON to parse and check, and the odd refusal or cut-off reply', decide: 'A typed value, already checked against the question' },
	{ k: 'You branch on', llm: '0.9, a number the model typed. Or token logprobs you turn into one', decide: '98%, the probability the model gave that answer' },
];
---

<div class="compare">
	<table>
		<thead>
			<tr>
				<td></td>
				<th scope="col"><span class="who"><Doodle size={32} face="lost" />General LLM, with structured output</span></th>
				<th scope="col" class="us"><span class="who"><Doodle size={32} face="glad" />decide</span></th>
			</tr>
		</thead>
		<tbody>
			<tr class="reply">
				<th scope="row">Comes back</th>
				<td data-col="General LLM">
					<pre>{llmReply}</pre>
					<span class="cap">An example reply. Yours will differ.</span>
				</td>
				<td data-col="decide" class="us">
					<pre><span class="flag">!</span> ready  <span class="flag">no</span>      <span class="flag">98%</span>
  size   small   60%</pre>
					<span class="cap">From the issue.md run above.</span>
				</td>
			</tr>
			{
				rows.map((r) => (
					<tr>
						<th scope="row">{r.k}</th>
						<td data-col="General LLM">{r.llm}</td>
						<td data-col="decide" class="us">
							{r.decide}
							{r.note && (
								<sup>
									<a href="#price-note" aria-label="Prices and sources">
										1
									</a>
								</sup>
							)}
						</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<p class="credit">LLMs are great at writing and reasoning. Use them for that, and use decide for the quick call your script makes on every item.</p>
	<p class="note" id="price-note">
		<sup>1</sup> Jev bills input only (<a href="https://docs.typesafe.ai/models">TypeSafe</a>). gemini-decision-1 bills $0.10 per million input tokens and writes
		no output tokens (<a href="https://aistudio.google.com/docs/pricing">Google</a>). OpenAI's Decisions API and Cloudflare bill on their own terms. For scale, the
		lowest standard price OpenAI lists for a chat model's output is $0.40 per million tokens, for gpt-5-nano (<a href="https://developers.openai.com/api/docs/pricing">OpenAI</a>).
	</p>
</div>

<style>
	.compare {
		margin-top: 40px;
		text-align: left;
	}
	/* A face beside each column head: lost in the reply, glad with the answer. */
	.who {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	/* The two replies, on small dark screens like every terminal. */
	pre {
		margin: 0;
		padding: 14px 16px;
		overflow-x: auto;
		background: var(--term-bg);
		border: 1px solid var(--term-border);
		font: 400 12.5px/1.6 var(--sl-font-mono);
		color: var(--term-fg);
		white-space: pre;
		scrollbar-width: thin;
		font-variant-ligatures: none;
	}
	.us pre {
		font-size: 15px;
		font-weight: 700;
	}
	.flag {
		color: #f7666f;
	}
	.cap {
		display: block;
		margin-top: 8px;
		font: 400 12px/1.4 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	table {
		display: table;
		width: 100%;
		margin: 0;
		border-collapse: collapse;
		border: 1px solid var(--sl-color-hairline);
		font-size: 15px;
		line-height: 1.5;
	}
	th,
	td {
		padding: 16px 20px;
		border: 0;
		border-top: 1px solid var(--sl-color-hairline);
		text-align: left;
		vertical-align: top;
		background: none;
	}
	thead th,
	thead td {
		border-top: 0;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	tbody th {
		width: 22%;
		font: 400 13px/1.6 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	tbody td {
		color: var(--sl-color-gray-3);
	}
	/* decide's column: the answer color on its edge, a faint fill, brighter text. */
	.us {
		width: 39%;
		background: var(--sl-color-gray-7);
		border-left: 2px solid var(--ans-value);
		color: var(--sl-color-white);
	}
	thead .us {
		font-weight: 700;
		color: var(--ans-value);
	}
	sup {
		margin-left: 3px;
		font: 400 11px/1 var(--sl-font-mono);
	}
	sup a {
		color: var(--sl-color-gray-3);
	}
	.note {
		max-width: 80ch;
		margin: 40px 0 0;
		font-size: 13px;
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.note a {
		color: var(--sl-color-gray-3);
	}
	.credit {
		margin: 28px 0 0;
		font-size: 16px;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	@media (max-width: 720px) {
		table,
		thead,
		tbody {
			display: block;
		}
		tr {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		tr + tr {
			border-top: 1px solid var(--sl-color-hairline);
		}
		thead {
			display: none;
		}
		tbody td::before {
			content: attr(data-col);
			display: block;
			margin-bottom: 4px;
			font: 400 11px/1.4 var(--sl-font-mono);
			color: var(--sl-color-gray-3);
		}
		tbody td.us::before {
			color: var(--ans-value);
		}
		th,
		td,
		td.us,
		tbody th {
			width: auto;
			border-top: 0;
			padding: 10px 12px;
			font-size: 14px;
		}
		thead th {
			font-size: 11.5px;
		}
		tbody th {
			grid-column: 1 / -1;
			padding: 18px 12px 0;
			font-size: 12px;
		}
		.reply td {
			grid-column: 1 / -1;
		}
	}
</style>
