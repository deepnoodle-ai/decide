---
// What you do with an answer: the three way branch in Go (allow, reject, or
// gate.Review for a person), then one card: stop a CI check on a flag. The
// hooks are linked from the "where" band above. The thresholds are placeholders: set yours on your
// own data. gate.Review is patterns/gate's Outcome for "a person looks".
const cards = [
	{
		title: 'triage.go',
		lang: 'go',
		lines: [
			'e, err := decide.Eval(ctx, client, issue,',
			'    decide.Noul(<span class="s">"Is this ready to work on?"</span>))',
			'<span class="k">if</span> err != nil {',
			'    <span class="k">return</span> err',
			'}',
			'<span class="k">switch</span> p := e.Answer.Noul; {',
			'<span class="k">case</span> p &gt;= 0.9:',
			'    assign(issue)              <span class="c">// allow</span>',
			'<span class="k">case</span> p &lt;= 0.1:',
			'    sendBack(issue)            <span class="c">// reject</span>',
			'<span class="k">default</span>:',
			'    route(issue, gate.Review)  <span class="c">// a person decides</span>',
			'}',
		],
		caption: 'assign, sendBack and route stand in for your own code. gate.Review is from patterns/gate.',
		wide: true,
	},
	{
		title: 'ci step',
		lang: 'sh',
		lines: ['<span class="pr">$ </span>decide run code-risk src \\', '    --fail-on flagged', '<span class="c"># exit 2 if anything is flagged</span>'],
		caption: 'Anything flagged exits 2, so the check fails and someone looks.',
		wide: false,
		solo: true,
	},
];
---

<div class="useit">
	{
		cards.map((c) => (
			<figure class:list={['card', { wide: c.wide || c.solo }]}>
				<div class="frame">
					<div class="bar">{c.title}</div>
					<pre set:html={c.lines.join('\n')} />
				</div>
				{c.wide && (
					<ol class="bands" aria-label="Three outcomes">
						<li class="pass"><code>&gt;= 0.9</code>allow</li>
						<li class="unsure"><code>in between</code>a person decides</li>
						<li class="flag"><code>&lt;= 0.1</code>reject</li>
					</ol>
				)}
				{c.wide && (
					<p class="people">decide makes the routine calls your scripts repeat all day. The ones that matter, and the ones it's unsure about, stay with your team.</p>
				)}
				<figcaption>{c.caption}</figcaption>
			</figure>
		))
	}
</div>

<style>
	.useit {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 20px;
		row-gap: 0;
		margin-top: 48px;
		text-align: left;
	}
	.card {
		display: grid;
		grid-row: span 2;
		grid-template-rows: subgrid;
		gap: 14px;
		min-width: 0;
		margin: 0;
	}
	.wide {
		display: flex;
		flex-direction: column;
		grid-column: 1 / -1;
		grid-row: auto;
		margin-bottom: 36px;
	}
	.frame {
		flex: 1;
		overflow: hidden;
		background: var(--term-bg);
		border: 1px solid var(--term-border);
		box-shadow: var(--term-shadow);
	}
	.bar {
		padding: 8px 14px;
		border-bottom: 1px solid var(--term-line);
		font: 400 11px/1.4 var(--sl-font-mono);
		color: var(--term-muted);
	}
	pre {
		margin: 0;
		padding: 16px 14px 18px;
		overflow-x: auto;
		background: none;
		border: 0;
		font: 400 12.5px/1.65 var(--sl-font-mono);
		color: var(--term-fg);
		white-space: pre;
		scrollbar-width: thin;
		font-variant-ligatures: none;
	}
	pre :global(.pr),
	pre :global(.c) {
		color: #5c6068;
	}
	pre :global(.k) {
		color: #b4b7bd;
	}
	pre :global(.s) {
		color: #dadce0;
	}
	/* The three outcomes, in the CLI's verdict colors. The middle one is the widest: it is where people come in. */
	.bands {
		display: grid;
		grid-template-columns: 1fr 2fr 1fr;
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--sl-color-hairline);
	}
	.bands li {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin: 0;
		padding: 10px 14px;
		border-top: 3px solid currentColor;
		font: 400 13px/1.4 var(--sl-font-mono);
	}
	.bands li + li {
		border-left: 1px solid var(--sl-color-hairline);
	}
	.bands code {
		padding: 0;
		background: none;
		font-size: 12px;
		color: var(--sl-color-gray-3);
	}
	.pass {
		color: var(--ans-pass);
	}
	.unsure {
		color: var(--ans-unsure);
		font: 500 15px/1.4 var(--sl-font-sans);
	}
	.flag {
		color: var(--ans-flag);
	}
	.people {
		margin: 0;
		font-size: 16px;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	figcaption {
		font-size: 14px;
		line-height: 1.55;
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 960px) {
		.useit {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0;
		}
		.wide {
			grid-column: auto;
			margin-bottom: 0;
		}
		.bands li {
			padding: 10px 8px;
		}
		.card + .card {
			margin-top: 28px;
		}
	}
	@media (max-width: 600px) {
		.bands {
			grid-template-columns: minmax(0, 1fr);
		}
		.bands li {
			flex-direction: row;
			align-items: baseline;
			gap: 12px;
		}
		.bands li + li {
			border-left: 0;
		}
	}
</style>
