---
// What you do with an answer: the three way branch in Go (allow, reject, or
// gate.Review for a person), highlighted with the site's code theme, then
// the three outcomes as a strip. Under it, the check to make before
// switching: run it on items you've already labeled. CI and hooks are
// linked from the "where" band above. The thresholds are placeholders.
// gate.Review is patterns/gate's Outcome for "a person looks".
import { Code } from 'astro:components';
import theme from '../styles/code-theme.json';

const go = `e, err := decide.Eval(ctx, client, issue,
    decide.Noul("Is this ready to work on?"))
if err != nil {
    return err
}
switch p := e.Answer.Noul; {
case p >= 0.9:
    assign(issue)              // allow
case p <= 0.1:
    sendBack(issue)            // reject
default:
    route(issue, gate.Review)  // a person decides
}`;
---

<div class="useit">
	<figure class="card">
		<div class="frame">
			<div class="bar">triage.go</div>
			<Code code={go} lang="go" theme={theme as any} />
		</div>
		<ol class="bands" aria-label="Three outcomes">
			<li class="pass"><code>&gt;= 0.9</code>allow</li>
			<li class="unsure"><code>in between</code>a person decides</li>
			<li class="flag"><code>&lt;= 0.1</code>reject</li>
		</ol>
	</figure>
	<div class="check">
		<div>
			<h3>Before you switch, test it on your own items.</h3>
			<p>Run it on items you've already labeled and compare. The probability is the model's judgment, not proof, so set your thresholds there too.</p>
		</div>
		<a class="btn ghost" href="https://github.com/deepnoodle-ai/decide/tree/main/examples/calibrate">See examples/calibrate →</a>
	</div>
</div>

<style>
