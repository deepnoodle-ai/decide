---
// The landing page's first screen, centred: the release line, the face
// thinking (while on screen), the headline,
// the tagline, and one command to run. The key and privacy line lives in
// the Providers band. The drawing in
// <Sweep> comes right after it, in the page body. Starlight's hero
// can't hold the install switcher, so this replaces it. Only the landing
// page has a `hero`.
//
// Keep on each Starlight upgrade: the <h1>'s id and data-page-title, and
// the shape of `data.hero`.
import Install from './Install.astro';
import Doodle from './Doodle.astro';
import plugin from '../../../plugin/.claude-plugin/plugin.json';

// Starlight's PAGE_TITLE_ID, which it does not export.
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
const version = `v${plugin.version}`;
const repo = 'https://github.com/deepnoodle-ai/decide';
---

<section class="hero">
	{
		data.release && (
			<a class="release" href={`${repo}/releases/tag/${version}`}>
				<b>{version}</b>
				<span>{data.release} →</span>
			</a>
		)
	}
	<div class="face"><Doodle size={96} face="ask" think="view" /></div>
	<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
	{tagline && <div class="tagline" set:html={tagline} />}
	<Install />
	<div class="actions">
		<a class="btn" href="/start/">Quickstart →</a>
		<a class="btn ghost" href="#adds">See what decide does</a>
	</div>
</section>

<style>
	.hero {
		padding-block: clamp(32px, 6vw, 72px) 0;
		text-align: center;
	}
	.release {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		max-width: 100%;
		margin-bottom: 28px;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.release b {
		flex: none;
		padding: 3px 7px;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0;
		font-weight: 400;
		color: var(--sl-color-white);
	}
	.release span {
		text-align: left;
	}
	.release:hover span {
		color: var(--sl-color-white);
	}
	.face {
		display: flex;
		justify-content: center;
		margin-bottom: 20px;
		color: var(--sl-color-white);
	}
	h1 {
		max-width: 15ch;
		margin: 0 auto;
		font-size: var(--display-1);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	/* The dim half always starts its own line, however the first half wraps. */
	h1 :global(.dim) {
		display: block;
		color: var(--sl-color-gray-3);
	}
	.tagline :global(p) {
		max-width: 60ch;
		margin: 24px auto 0;
		font-size: 17px;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	/* Under the command, on their own row: a splash page has no menu, so
	   the hero carries the way into the docs. */
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		margin-top: 20px;
	}
	@media (max-width: 600px) {
		.release {
			flex-direction: column;
			gap: 10px;
		}
		.release span {
			text-align: center;
			text-wrap: balance;
		}
	}
</style>
