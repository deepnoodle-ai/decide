---
// The landing page's first screen, centred: the release line, the face
// thinking (while on screen), the headline,
// the tagline, one command to run, and where the key goes. The recordings
// come right after it, in <RunStage> in the page body. Starlight's hero
// can't hold the install switcher, so this replaces it. Only the landing
// page has a `hero`.
//
// Keep on each Starlight upgrade: the <h1>'s id and data-page-title, and
// the shape of `data.hero`.
import Install from './Install.astro';
import Doodle from './Doodle.astro';
import plugin from '../../../plugin/.claude-plugin/plugin.json';

// Starlight's PAGE_TITLE_ID, which it does not export.
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
const version = `v${plugin.version}`;
const repo = 'https://github.com/deepnoodle-ai/decide';
---

<section class="hero">
	{
		data.release && (
			<a class="release" href={`${repo}/releases/tag/${version}`}>
				<b>{version}</b>
				<span>{data.release} →</span>
			</a>
		)
	}
	<div class="face"><Doodle size={96} face="ask" think="view" /></div>
	<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
	{tagline && <div class="tagline" set:html={tagline} />}
	<Install />
	<p class="key">
		Bring your own key from TypeSafe, Cloudflare, OpenAI or Google. decide sends what you ask about to that provider and nowhere else.
	</p>
	<a class="start" href="/start/">Read the quickstart →</a>
</section>

<style>
	.hero {
		padding-block: clamp(32px, 6vw, 72px) 0;
		text-align: center;
	}
	.release {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		max-width: 100%;
		margin-bottom: 28px;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.release b {
		flex: none;
		padding: 3px 7px;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0;
		font-weight: 400;
		color: var(--sl-color-white);
	}
	.release span {
		text-align: left;
	}
	.release:hover span {
		color: var(--sl-color-white);
	}
	.face {
		display: flex;
		justify-content: center;
		margin-bottom: 20px;
		color: var(--sl-color-white);
	}
	h1 {
		max-width: 15ch;
		margin: 0 auto;
		font-size: var(--display-1);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	h1 :global(.dim) {
		color: var(--sl-color-gray-3);
	}
	.tagline :global(p) {
		max-width: 46ch;
		margin: 24px auto 0;
		font-size: 17px;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	.key {
		max-width: 60ch;
		margin: 22px auto 0;
		font-size: 16px;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	/* A splash page has no menu, so the hero carries the way into the docs. */
	.start {
		display: inline-block;
		margin-top: 14px;
		font-size: 14.5px;
		font-weight: 500;
		color: var(--sl-color-white);
		text-decoration: underline;
		text-decoration-color: var(--sl-color-gray-4);
		text-underline-offset: 0.22em;
	}
	.start:hover {
		text-decoration-color: currentColor;
	}
	@media (max-width: 600px) {
		.release {
			flex-direction: column;
			gap: 10px;
		}
		.release span {
			text-align: center;
			text-wrap: balance;
		}
	}
</style>
