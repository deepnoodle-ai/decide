---
// Starlight's footer, then our line. The doodle sits at the head of it, small
// and muted, so it reads as a signature; hover the line and it thinks.
import Default from '@astrojs/starlight/components/Footer.astro';
import Doodle from './Doodle.astro';
---

<Default />
<div class="made" data-doodle-hover>
	<span class="left">
		<Doodle size={20} />
		<span>decide is open source under Apache 2.0.</span>
	</span>
	<span>Made by <a href="https://deepnoodle.ai">Deep Noodle</a></span>
</div>

<style>
	.made {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.made a {
		color: var(--sl-color-gray-2);
		text-decoration-color: var(--sl-color-gray-4);
		text-underline-offset: 0.22em;
	}
	.made a:hover {
		color: var(--sl-color-white);
	}
	.left {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	/* It brightens with the line it belongs to, and never on its own. */
	.made:hover .left :global(.doodle) {
		color: var(--sl-color-gray-2);
	}
	.left :global(.doodle) {
		transition: color 120ms var(--ease);
	}
</style>
