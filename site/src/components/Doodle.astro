---
// The character: a hand-drawn lumpy head the pen carried past where it
// started, two mismatched eyes, one brow shoved up, and a small mouth.
// It stands in for the reader, who is always thinking very hard. It is the
// question; decide is the answer. It never has a name: decorative uses are
// aria-hidden, and a link around it is labeled by where it goes.
//
// The wobble was generated once from a seed and baked into these paths, so it
// is the same drawing in every build. Every face keeps the head, the
// raised brow and the two eye anchors (11.7,11.2 and 19.8,10.75), and only
// swaps what sits on those anchors.
//
// Pen rule: strokes use non-scaling-stroke, so the line is the same weight at
// every size. The width comes from --doodle-pen, set by the size preset (mark
// 1.5px, small 2px, poster 3px). Brow and mouth draw at 0.85 of it. No drip:
// the face thinks, it does not drool. Filled eyes scale with the drawing.
//
// Faces:
//   ask        thinking, with three thought dots
//   lost       X eyes; `trail` lets the dots trail off into a "?"
//   glad       ^ ^ eyes and a smile
//   glad-card  glad, holding a tag whose text comes from `tag`
//   mark       head, eyes, brow and one thought dot, for tiny sizes
//
// The dots think while an ancestor marked `data-doodle-hover` is hovered,
// while the face is on screen with `think="view"`, or always with `thinking`.
// They rise and swell in turn; every third cycle the last dot turns into a
// "?" and fades. Reduced motion keeps everything still and fully drawn.
type Face = 'ask' | 'lost' | 'glad' | 'glad-card' | 'mark';
type Preset = 'mark' | 'small' | 'poster';
interface Props {
	/** Rendered height in px, or a preset (mark 20, small 64, poster 200). */
	size?: number | Preset;
	/** Pen preset; inferred from the size when omitted. */
	pen?: Preset;
	/** A label, for standalone use. Omit where it is decoration (almost always). */
	title?: string;
	face?: Face;
	/** Think continuously, not only on hover. */
	thinking?: boolean;
	/** Think while on screen (a few lines of script; still without it). */
	think?: 'hover' | 'view';
	/** Lost face only: the thought dots trail off into a "?". */
	trail?: boolean;
	/** glad-card only: the text on the tag, such as a real answer value. */
	tag?: string;
	/** glad-card only: color the tag text as a flagged answer or a plain value. */
	tone?: 'flag' | 'value' | 'plain';
	class?: string;
}
const {
	size = 20,
	pen,
	title,
	face = 'ask',
	thinking = false,
	think = 'hover',
	trail = false,
	tag = '',
	tone = 'flag',
	class: extra,
} = Astro.props;

const presetPx: Record<Preset, number> = { mark: 20, small: 64, poster: 200 };
const px = typeof size === 'number' ? size : presetPx[size];
const penPreset: Preset = pen ?? (typeof size === 'string' ? size : px <= 24 ? 'mark' : px < 160 ? 'small' : 'poster');
const penPx = { mark: 1.5, small: 2, poster: 3 }[penPreset];

// The tag is sized from its text: mono glyphs are about 0.6em wide.
const tagFont = 5;
const tagW = face === 'glad-card' ? Math.max(10, tag.length * tagFont * 0.62 + 5) : 0;
const tagX = 33;

let vb = [-2, -2, 36, 36];
if (face === 'glad-card') vb = [-2, -2, tagX + tagW + 4, 36];
if (face === 'lost' && trail) vb = [-2, -12, 50, 46];
const width = Math.round((px * vb[2]) / vb[3]);

const showDots = face === 'ask' || face === 'mark';
const animated = face === 'ask';
---

<svg
	class:list={['doodle', `face-${face}`, { thinking, inview: think === 'view' }, extra]}
	style={`--doodle-pen:${penPx}px`}
	width={width}
	height={px}
	viewBox={vb.join(' ')}
	fill="none"
	stroke="currentColor"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={title ? 'img' : undefined}
	aria-hidden={title ? undefined : 'true'}
	data-doodle-view={think === 'view' ? '' : undefined}
>
	{title && <title>{title}</title>}
	<g transform="rotate(-9 15.6 14.4)">
		<path
			class="pen"
			d="M18.59 4.84C19.43 5.39 22.46 7 23.61 8.14C24.76 9.27 25.21 9.98 25.5 11.63C25.79 13.27 25.8 16.2 25.35 18.01C24.9 19.83 23.96 21.49 22.8 22.52C21.65 23.55 20.14 23.96 18.43 24.21C16.72 24.46 14.31 24.47 12.55 24.01C10.79 23.54 9.02 22.67 7.86 21.43C6.69 20.18 5.81 18.36 5.56 16.55C5.32 14.73 5.74 12.19 6.39 10.55C7.03 8.9 8.35 7.72 9.42 6.67C10.48 5.61 12.22 4.64 12.78 4.23"
		></path>
		<path class="pen fine" d="M16.6 7C17.5 6.7 19.4 6.75 20.3 7.15C21.1 7.5 21.6 8.1 21.9 8.4"></path>
		{
			(face === 'ask' || face === 'mark') && (
				<g class="eyes" fill="currentColor" stroke="none">
					<ellipse cx="11.7" cy="11.2" rx="2.15" ry="2.3"></ellipse>
					<ellipse cx="19.8" cy="10.75" rx="1.35" ry="1.6"></ellipse>
				</g>
			)
		}
		{face === 'ask' && <path class="pen fine" d="M9.8 18.35C10.9 18.8 12.6 19 14.3 18.7"></path>}
		{
			face === 'lost' && (
				<>
					<path class="pen fine" d="M9.8 9.2C10.6 10.2 12.3 12 13.6 13.2"></path>
					<path class="pen fine" d="M13.6 9.3C12.7 10.3 10.9 12.1 9.8 13.2"></path>
					<path class="pen fine" d="M18.5 9.4C19 10 20.3 11.4 21.1 12.1"></path>
					<path class="pen fine" d="M21.1 9.4C20.5 10 19.3 11.4 18.5 12.1"></path>
					<path class="pen fine" d="M9.5 18.5C10.5 17.7 11.4 19.3 12.6 18.6C13.6 18 14.3 18.8 14.9 18.9"></path>
				</>
			)
		}
		{
			(face === 'glad' || face === 'glad-card') && (
				<>
					<path class="pen" d="M9.5 12.4C10.1 10.4 11.2 9.6 11.8 9.6C12.4 9.6 13.4 10.5 13.9 12.3"></path>
					<path class="pen" d="M18.5 11.7C18.9 10.4 19.4 9.8 19.8 9.8C20.2 9.8 20.8 10.4 21.1 11.6"></path>
					<path class="pen fine" d="M9.7 17.9C10.9 19.6 13.3 19.9 14.9 18.3"></path>
				</>
			)
		}
		{
			animated && (
				<g class="dots" fill="currentColor" stroke="none">
					<circle class="dot d1" cx="26.2" cy="8.2" r="0.85"></circle>
					<circle class="dot d2" cx="28.1" cy="5.8" r="1.1"></circle>
					<circle class="dot d3" cx="29.8" cy="3.4" r="1.35"></circle>
					<g class="q" transform="translate(-4.6 1.8)">
						<path class="pen fine" fill="none" stroke="currentColor" d="M31.2 -0.6C31.4 -1.5 32.6 -1.7 33 -1C33.4 -0.3 32.5 0.2 32.3 0.8"></path>
						<circle cx="32.25" cy="2.1" r="0.45"></circle>
					</g>
				</g>
			)
		}
		{face === 'mark' && <circle fill="currentColor" stroke="none" cx="28.4" cy="5" r="2.1"></circle>}
	</g>
	{
		face === 'lost' && trail && (
			<g class="trail">
				<path class="pen trail-line" d="M26.6 7.2C29 4.5 30.4 1 33.6 -0.8C36.6 -2.5 39.4 -1.2 41 -3.6"></path>
				<path class="pen fine" d="M42.3 -8.4C42.7 -9.9 44.6 -10.2 45.3 -9C45.9 -7.9 44.6 -7.2 44.2 -6.2"></path>
				<circle cx="44.1" cy="-4.3" r="0.6" fill="currentColor" stroke="none"></circle>
			</g>
		)
	}
	{
		face === 'glad-card' && (
			<g class="card">
				<path class="pen fine" d="M24.6 17.6C26.6 18.6 29.2 18.8 31.6 18.2"></path>
				<g transform={`rotate(4 ${tagX} 18)`}>
					<rect class="pen" x={tagX} y="13.4" width={tagW} height="9.4" fill="var(--doodle-card, none)"></rect>
					<circle cx={tagX + 2.2} cy="18.1" r="0.7" fill="currentColor" stroke="none"></circle>
					<text
						class:list={['tag', `tone-${tone}`]}
						x={tagX + 4 + (tagW - 4) / 2}
						y="19.9"
						text-anchor="middle"
						font-size={tagFont}
						stroke="none"
					>
						{tag}
					</text>
				</g>
			</g>
		)
	}
</svg>

{
	think === 'view' && (
		<script>
			const els = document.querySelectorAll<SVGElement>('[data-doodle-view]');
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver((entries) => {
					for (const e of entries) e.target.classList.toggle('seen', e.isIntersecting);
				});
				els.forEach((el) => io.observe(el));
			}
		</script>
	)
}

<style>
	.doodle {
		display: block;
		flex: none;
		overflow: visible;
	}
	.pen {
		vector-effect: non-scaling-stroke;
		stroke-width: var(--doodle-pen, 2px);
	}
	.pen.fine {
		stroke-width: calc(var(--doodle-pen, 2px) * 0.85);
	}
	.trail-line {
		stroke-dasharray: 0 calc(var(--doodle-pen, 2px) * 3.2);
		stroke-width: calc(var(--doodle-pen, 2px) * 1.3);
	}
	.tag {
		font-family: var(--sl-font-mono, ui-monospace, monospace);
		font-weight: 700;
		fill: currentColor;
	}
	.tag.tone-flag {
		fill: var(--ans-flag, currentColor);
	}
	.tag.tone-value {
		fill: var(--ans-value, currentColor);
	}
	.dot {
		transform-box: fill-box;
		transform-origin: center;
	}
	/* At rest: three dots. The "?" is the punchline of the motion. */
	.q {
		opacity: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.q {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.doodle.thinking .eyes,
		.doodle.seen .eyes,
		:global([data-doodle-hover]:hover) .doodle .eyes,
		.doodle:hover .eyes {
			animation: drift 4.8s ease-in-out infinite;
		}
		.doodle.thinking :is(.d1, .d2),
		.doodle.seen :is(.d1, .d2),
		:global([data-doodle-hover]:hover) .doodle :is(.d1, .d2),
		.doodle:hover :is(.d1, .d2) {
			animation: rise 2.4s ease-in-out infinite;
		}
		.doodle.thinking .d2,
		.doodle.seen .d2,
		:global([data-doodle-hover]:hover) .doodle .d2,
		.doodle:hover .d2 {
			animation-delay: 0.3s;
		}
		.doodle.thinking .d3,
		.doodle.seen .d3,
		:global([data-doodle-hover]:hover) .doodle .d3,
		.doodle:hover .d3 {
			animation: rise3 7.2s ease-in-out 0.6s infinite;
		}
		.doodle.thinking .q,
		.doodle.seen .q,
		:global([data-doodle-hover]:hover) .doodle .q,
		.doodle:hover .q {
			animation: ask 7.2s ease-in-out 0.6s infinite;
		}
	}
	@keyframes drift {
		0%, 20%, 100% { transform: translate(0, 0); }
		45%, 70% { transform: translate(1.1px, -1.1px); }
	}
	@keyframes rise {
		0%, 100% { opacity: 0.2; transform: translateY(0) scale(1); }
		40%, 70% { opacity: 1; transform: translateY(-1px) scale(1.15); }
	}
	/* Two ordinary cycles, then the third dot gives way to a "?". */
	@keyframes rise3 {
		0%, 33.3%, 66.6% { opacity: 0.2; transform: translateY(0) scale(1); }
		13.3%, 23.3%, 46.6%, 56.6% { opacity: 1; transform: translateY(-1px) scale(1.15); }
		72%, 96% { opacity: 0; transform: translateY(-1px) scale(0.6); }
		100% { opacity: 0.2; transform: translateY(0) scale(1); }
	}
	@keyframes ask {
		0%, 68% { opacity: 0; }
		76%, 88% { opacity: 1; }
		100% { opacity: 0; }
	}
</style>
