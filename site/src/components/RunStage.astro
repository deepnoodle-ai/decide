---
// The landing page's big terminal: five real recordings behind file tabs in
// one window. Each recording is a full <Terminal>, and only the chosen one
// shows, so Terminal's own observer plays it and pauses the rest. Without
// JavaScript the first one shows. See "Landing page" in
// docs/design/docs-site-look.md.
import Terminal from './Terminal.astro';

const runs = [
	{ file: 'issue.md', tape: 'triage-check', title: '~/decide/demo', label: 'decide flags a vague issue as not ready and exits with code 2' },
	{ file: 'change.diff', tape: 'review-gate', title: '~/shop', label: 'decide exits with code 2 because two functions are flagged' },
	{
		file: 'ticket.txt',
		tape: 'type-choice',
		title: '~/support',
		label: 'decide routes a double charge ticket to billing',
		// The recording writes this project template first, off camera.
		note: 'ticket is a one question project template in .decide/templates. The built in ticket-routing asks the same thing.',
	},
	{ file: 'review.txt', tape: 'start-line', title: '~', label: 'decide answers positive about one line of text' },
	{
		file: 'total.go',
		tape: 'type-score',
		title: '~/shop',
		label: 'decide scores a short Go function 3.9 of 4 for maintainability',
		note: 'code is a one question project template in .decide/templates. The built in code-risk rates maintainability too.',
	},
];
---

<div class="stage" data-stage>
	{
		runs.map((run, i) => (
			<div class="run" data-run={i} hidden={i > 0}>
				<Terminal tape={run.tape} title={run.title} label={run.label} compact lights>
					<div slot="tabs" class="files" role="tablist" aria-label="Example runs">
						{runs.map((r, k) => (
							<button type="button" role="tab" data-pick={k} aria-selected={k === i ? 'true' : 'false'} tabindex={k === i ? 0 : -1}>
								{r.file}
							</button>
						))}
					</div>
				</Terminal>
				<p class="note">{run.note}</p>
			</div>
		))
	}
	<p class="cap">
		Real runs, recorded with VHS from <a href="https://github.com/deepnoodle-ai/decide/tree/main/site/tapes">site/tapes</a>. Nothing is mocked.
	</p>
</div>

<style>
	/* As wide as a recording made with settings.tape (1552px at 2x), and as tall
	   as the tallest, so a run fills the window and switching runs never moves the page. */
	.stage {
		max-width: 778px;
		margin: clamp(64px, 9vw, 96px) auto 0;
		text-align: left;
	}
	.stage :global(.term-screen) {
		min-height: 456px;
	}
	@media (max-width: 49.99rem) {
		.stage :global(.term-screen) {
			min-height: 342px;
		}
		.stage .note {
			min-height: 4.5em;
		}
	}
	.stage :global(.term) {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			0 30px 80px -24px rgba(0, 0, 0, 0.65),
			0 12px 24px -12px rgba(0, 0, 0, 0.4);
	}
	.files {
		display: flex;
		overflow-x: auto;
		scrollbar-width: none;
		background: var(--term-bar);
		border-bottom: 1px solid var(--term-line);
	}
	.files button {
		flex: 1 0 auto;
		margin: 0;
		padding: 8px 14px;
		background: none;
		border: 0;
		border-right: 1px solid var(--term-line);
		font: 400 12px/1.3 var(--sl-font-mono);
		color: var(--term-muted);
		cursor: pointer;
	}
	.files button:last-child {
		border-right: 0;
	}
	.files button:hover {
		color: var(--term-fg);
	}
	.files button[aria-selected='true'] {
		background: var(--term-bg);
		color: var(--term-fg);
	}
	.note,
	.cap {
		margin: 12px 0 0;
		text-align: center;
		font: 400 12px/1.5 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	.cap {
		color: var(--sl-color-gray-4);
	}
	.cap a {
		color: var(--sl-color-gray-3);
	}
	/* Every run keeps room for a note, so switching runs never moves the page. */
	.note {
		min-height: 3em;
	}
	.note + .cap {
		margin-top: 4px;
	}
</style>

<script>
	// Show one run at a time. Arrow keys move along the tabs, as in any tablist.
	for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
		const runs = [...stage.querySelectorAll<HTMLElement>('[data-run]')];
		const show = (i: number, focus: boolean) => {
			runs.forEach((run, k) => (run.hidden = k !== i));
			if (focus) runs[i].querySelector<HTMLElement>(`[data-pick="${i}"]`)?.focus();
		};
		stage.addEventListener('click', (e) => {
			const tab = (e.target as Element).closest<HTMLElement>('[data-pick]');
			if (tab) show(Number(tab.dataset.pick), false);
		});
		stage.addEventListener('keydown', (e) => {
			const tab = (e.target as Element).closest<HTMLElement>('[data-pick]');
			if (!tab) return;
			const i = Number(tab.dataset.pick);
			const last = runs.length - 1;
			const next = { ArrowLeft: i ? i - 1 : last, ArrowRight: i < last ? i + 1 : 0, Home: 0, End: last }[e.key];
			if (next === undefined) return;
			e.preventDefault();
			show(next, true);
		});
	}
</script>
