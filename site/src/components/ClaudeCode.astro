---
// "A second opinion inside Claude Code." (anchor #claude-code): the plugin,
// which the page otherwise shows only as an install tab. Five rows on the
// left: three things it does on its own, then the two skills you run. On
// the right, the two install lines on a dark panel and the guide. Facts
// are from /reference/claude-code/. No recording: the tapes record the
// CLI, not Claude Code, and nothing here is drawn to look like one.
import CopyButton from './CopyButton.astro';
import Haystack from './Haystack.astro';

const rows = [
	{
		k: 'on its own',
		title: 'Catches prompt injection',
		line: "After Claude reads a web page, search results, an MCP tool's result or curl output, decide checks whether it tries to take over the agent or hide text from you. Claude reads a warning beside the result.",
	},
	{
		k: 'in bypass mode',
		title: 'Stops severe commands',
		line: "Before each shell command runs, decide checks whether it could do harm that's hard to undo, such as force-pushing a shared branch. You choose whether it runs.",
	},
	{
		k: 'a tool for Claude',
		title: 'Answers Claude’s own questions',
		line: 'With the judge tool, Claude asks typed questions about up to 200 items at once, such as which of these issues are bugs.',
	},
	{
		k: '/decide:audit',
		cmd: true,
		title: 'Audits a repository for security bugs',
		line: 'decide scores every function with the security template. Claude reads up to 15 of the highest with their callers, and reports which are real.',
	},
	{
		k: '/decide:hunt',
		cmd: true,
		title: 'Finds where a fixed bug was repeated',
		line: 'Give it a fix commit or pull request. Claude writes one question about the mistake, decide asks it of every function, and Claude reads the top matches.',
	},
];
const lines = ['/plugin marketplace add deepnoodle-ai/decide', '/plugin install decide@decide'];
---

<div class="cc">
	<ul class="rows">
		{
			rows.map((r) => (
				<li>
					<p class:list={['k', { cmd: r.cmd }]}>{r.k}</p>
					<div>
						<h3>{r.title}</h3>
						<p class="line">{r.line}</p>
					</div>
				</li>
			))
		}
	</ul>
	<div class="side">
		<div class="panel">
			<p class="label">In Claude Code</p>
			<div class="cmd">
				<pre>{lines.map((l) => <span class="l"><span class="pr">&gt; </span>{l}</span>)}</pre>
				<CopyButton text={lines.join('\n')} label="Copy commands" />
			</div>
			<p class="needs">Needs the decide CLI and a key for a decision model.</p>
		</div>
		<a class="btn" href="/reference/claude-code/">Claude Code guide →</a>
		<Haystack />
	</div>
</div>

<style>
	.cc {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
		gap: 48px;
		align-items: start;
		margin-top: 48px;
		text-align: left;
	}
	.rows {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.rows li {
		display: grid;
		grid-template-columns: 190px minmax(0, 1fr);
		gap: 24px;
		margin: 0;
		padding: 22px 0;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.k {
		margin: 4px 0 0;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
	/* A skill's name is something you type, so it is set like a command. */
	.k.cmd {
		letter-spacing: 0;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	h3 {
		margin: 0;
		font-size: 20px;
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
	}
	.line {
		max-width: 56ch;
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.side {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}
	/* Dark in both themes, like every terminal on the site. */
	.panel {
		width: 100%;
		padding: 20px;
		background: var(--term-bg);
		border: 1px solid var(--term-border);
	}
	.label {
		margin: 0 0 12px;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		letter-spacing: 0.04em;
		color: var(--term-muted);
	}
	.cmd {
		display: flex;
		align-items: flex-start;
		gap: 12px;
	}
	.cmd pre {
		flex: 1;
		min-width: 0;
		margin: 0;
		padding: 0;
		overflow-x: auto;
		background: none;
		border: 0;
		font: 400 12.5px/1.8 var(--sl-font-mono);
		color: var(--term-fg);
		scrollbar-width: none;
	}
	.cmd :global(.copy) {
		color: var(--term-muted);
		border-color: var(--term-border);
	}
	.l {
		display: block;
		white-space: nowrap;
	}
	.pr {
		color: var(--term-muted);
	}
	.needs {
		margin: 14px 0 0;
		font-size: 13px;
		line-height: 1.5;
		color: var(--term-muted);
	}
	@media (max-width: 1000px) {
		.cc {
			grid-template-columns: minmax(0, 1fr);
			gap: 28px;
		}
		.side {
			position: static;
		}
	}
	@media (max-width: 600px) {
		.rows li {
			grid-template-columns: minmax(0, 1fr);
			gap: 6px;
			padding: 20px 0;
		}
		.k {
			margin: 0;
		}
	}
</style>
