---
// The templates and data are shared with the tapes. TestTapes keeps the
// commands working; the recording supplies every probability and score.
import Terminal from './Terminal.astro';
import { Code } from '@astrojs/starlight/components';
import command from '../snippets/type-noul.json?raw';
import ticket from '../snippets/type-choice.json?raw';
import code from '../snippets/type-score.json?raw';
import codeInput from '../snippets/type-score.txt?raw';
const types = [
 { name: 'Yes or no', kind: 'noul', tape: 'type-noul', file: '.decide/templates/command/template.json', data: 'command.txt', template: command,
   question: 'Could this command destroy work that is hard to get back?',
   input: 'git push --force origin main', rule: 'Flagged when yes is at least 80% likely.' },
 { name: 'One of several', kind: 'choice', tape: 'type-choice', file: '.decide/templates/ticket/template.json', data: 'ticket.txt', template: ticket,
   question: 'Which team should handle this support ticket?',
   input: 'I was charged twice for my subscription.', rule: 'Choose a named option, with its probability.' },
 { name: 'A point on a scale', kind: 'score', tape: 'type-score', file: '.decide/templates/code/template.json', data: 'code.txt', template: code,
   question: 'How easy is this code to understand and safely change?',
   input: codeInput.trim(), rule: 'Five levels, from 0 to 4. Flagged at 1.5 or less.' },
];
---

<div class="types not-content">
 {types.map((type) => (
  <section class="type">
   <div class="explain">
    <h3>{type.name} <code>{type.kind}</code></h3>
    <p>{type.question}</p>
    <blockquote>{type.input}</blockquote>
    <p class="rule">{type.rule}</p>
    <details>
     <summary>Try this template</summary>
     <p>Save the template as <code>{type.file}</code> and the input as <code>{type.data}</code>. Then copy the command below the recording.</p>
     <Code code={type.template} lang="json" title={type.file} />
    </details>
   </div>
   <Terminal tape={type.tape} title="~" label={`A real ${type.kind} answer with its probability or score`} />
  </section>
 ))}
</div>

<style>
 .types { display: grid; gap: 20px; margin-top: 32px; }
 .type { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 32px; align-items: start; padding: 24px; border: 1px solid var(--sl-color-hairline); border-radius: 12px; }
 .explain { min-width: 0; }
 h3 { margin: 0; font-size: 20px; line-height: 1.3; color: var(--sl-color-white); }
 h3 code { margin-left: 6px; font-size: 12.5px; font-weight: 400; color: var(--sl-color-gray-3); }
 p { margin: 14px 0 0; color: var(--sl-color-gray-2); line-height: 1.5; }
 blockquote { margin: 20px 0; padding: 0 0 0 14px; border-left: 1px solid var(--sl-color-gray-3); font: 400 13.5px/1.6 var(--sl-font-mono); color: var(--sl-color-white); overflow-wrap: anywhere; }
 .rule { font-size: 13px; color: var(--sl-color-gray-3); }
 details { margin-top: 20px; }
 summary { cursor: pointer; font-size: 13px; color: var(--sl-color-gray-2); }
 details p { font-size: 13px; margin-bottom: 12px; }
 .type :global(.term-wrap) { min-width: 0; margin: 0; }
 @media (max-width: 799px) {
  .type { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 18px; }
  h3 { font-size: 18px; }
 }
</style>
