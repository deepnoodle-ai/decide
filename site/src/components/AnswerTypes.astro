---
// The three answer types, each with one question and the answer decide
// printed for it. The answer lines are read from the type-* tapes'
// transcripts, so every probability and score is from a recorded run.
// TestTapes keeps the tapes' commands working.
import { loadTape, transcript } from '../lib/tapes';

const types = [
	{ name: 'Yes or no', kind: 'noul', tape: 'type-noul', question: 'Could this command destroy work that is hard to get back?' },
	{ name: 'One of several', kind: 'choice', tape: 'type-choice', question: 'Which team should handle this support ticket?' },
	{ name: 'A point on a scale', kind: 'score', tape: 'type-score', question: 'How easy is this code to understand and safely change?' },
];

// The item and its answer: the transcript's second block of lines.
async function answer(name: string) {
	const text = await transcript(name, loadTape(name));
	const block = text.split(/\n\s*\n/)[1];
	if (!block) throw new Error(`The ${name} transcript has no answer block`);
	return block.split('\n').map((line) => ({ line, flagged: line.startsWith('!') }));
}
const rows = await Promise.all(types.map(async (t) => ({ ...t, lines: await answer(t.tape) })));
---

<div class="types not-content">
	{
		rows.map((type) => (
			<section class="type">
				<div class="explain">
					<h3>
						{type.name} <code class="kind">{type.kind}</code>
					</h3>
					<p>{type.question}</p>
				</div>
				<pre>{type.lines.map((l) => <span class:list={['l', { flagged: l.flagged }]}>{l.line}</span>)}</pre>
			</section>
		))
	}
</div>

<style>
	.types {
		margin-top: 1.5rem;
		border: 1px solid var(--sl-color-hairline);
	}
	.type + .type {
		border-top: 1px solid var(--sl-color-hairline);
	}
	.explain {
		min-width: 0;
		padding: 16px 20px 14px;
	}
	h3 {
		margin: 0;
		font-size: 17px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.kind {
		margin-left: 6px;
		padding: 0;
		background: none;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	p {
		margin: 4px 0 0;
		font-size: 15px;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	/* The answer, dark in both themes like every terminal on the site. */
	pre {
		margin: 0;
		padding: 14px 20px;
		overflow-x: auto;
		background: var(--term-bg);
		border: 0;
		border-radius: 0;
		font: 400 13px/1.7 var(--sl-font-mono);
		color: var(--term-fg);
	}
	.l {
		display: block;
		white-space: pre;
	}
	.l:first-child {
		color: var(--term-muted);
	}
	.l.flagged {
		color: #f7666f;
	}
</style>
