---
// The wordmark: "decide" in mono, then the release number. The number
// comes from plugin.json, which names the next release, so a preview shows
// the version it will ship in.
import plugin from '../../../plugin/.claude-plugin/plugin.json';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="name">decide</span>
	<span class="version">v{plugin.version}</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: baseline;
		gap: 10px;
		text-decoration: none;
		white-space: nowrap;
	}
	.name {
		font: 700 19px/1 var(--sl-font-mono);
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}
	.version {
		font: 500 12px/1 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
</style>
