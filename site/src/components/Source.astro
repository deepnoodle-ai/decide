---
// "No black box. Except the model.", cut down to one band: the clone
// command, then Apache 2.0 in one plain sentence with links to the licence
// and CONTRIBUTING.md inline. No box: it is lighter than the bands above.
import CopyButton from './CopyButton.astro';

const repo = 'https://github.com/deepnoodle-ai/decide';
const clone = `git clone ${repo}`;
---

<div class="open">
	<div class="cmd">
		<pre><span class="pr">$ </span>{clone}</pre>
		<CopyButton text={clone} />
	</div>
	<p class="terms">
		<b>Apache 2.0, in plain words:</b> use it, change it, sell what you build with it. <a href={`${repo}/blob/main/LICENSE`}>Read the LICENSE →</a>
		<a href={`${repo}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING.md →</a>
	</p>
</div>

<style>
	.open {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'cmd' 'terms';
		gap: 16px;
		align-items: start;
		margin-top: 32px;
		text-align: left;
	}
	.cmd {
		grid-area: cmd;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-width: 0;
		padding: 12px 14px;
		background: var(--term-bg);
		border: 1px solid var(--term-border);
	}
	pre {
		margin: 0;
		padding: 0;
		overflow-x: auto;
		background: none;
		border: 0;
		font: 400 13px/1.5 var(--sl-font-mono);
		color: var(--term-fg);
		scrollbar-width: thin;
	}
	.pr {
		color: var(--term-muted);
	}
	.terms {
		grid-area: terms;
		margin: 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.terms b {
		font-weight: 500;
		color: var(--sl-color-white);
	}
	.terms a {
		margin-left: 12px;
		font: 400 13px/1.4 var(--sl-font-mono);
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}
</style>
