---
// The landing page's one command to run, with a word switcher above it for
// the other ways in. Without JavaScript the brew command shows.
import CopyButton from './CopyButton.astro';

const ways = [
	{ name: 'brew', prompt: '$', lines: ['brew install deepnoodle-ai/tap/decide'] },
	{ name: 'go install', prompt: '$', lines: ['go install github.com/deepnoodle-ai/decide/cmd/decide@latest'] },
	{ name: 'go get', prompt: '$', lines: ['go get github.com/deepnoodle-ai/decide'] },
	{ name: 'claude code', prompt: '>', lines: ['/plugin marketplace add deepnoodle-ai/decide', '/plugin install decide@decide'] },
];
---

<div class="install" data-install>
	<div class="switch" role="tablist" aria-label="Install">
		{
			ways.map((w, i) => (
				<button type="button" role="tab" data-way={i} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
					{w.name}
				</button>
			))
		}
	</div>
	{
		ways.map((w, i) => (
			<div class="cmd" data-cmd={i} hidden={i > 0}>
				<pre>{w.lines.map((l) => <span class="line"><span class="pr">{w.prompt} </span>{l}</span>)}</pre>
				<CopyButton text={w.lines.join('\n')} label={w.lines.length > 1 ? 'Copy commands' : 'Copy command'} />
			</div>
		))
	}
</div>

<style>
	.install {
		display: inline-flex;
		flex-direction: column;
		gap: 10px;
		max-width: 100%;
		min-width: min(100%, 460px);
		margin-top: 40px;
	}
	.switch {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2px;
	}
	.switch button {
		margin: 0;
		padding: 7px 10px;
		background: none;
		border: 0;
		font: 400 12.5px/1 var(--sl-font-mono);
		color: var(--sl-color-gray-4);
		cursor: pointer;
	}
	.switch button:hover {
		color: var(--sl-color-gray-2);
	}
	.switch button[aria-selected='true'] {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 6px;
	}
	.cmd {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 10px 10px 10px 18px;
		border: 1px solid var(--sl-color-gray-4);
		text-align: left;
	}
	.cmd[hidden] {
		display: none;
	}
	.cmd pre {
		flex: 1;
		min-width: 0;
		margin: 0;
		padding: 0;
		background: none;
		border: 0;
		font: 400 14px/1.6 var(--sl-font-mono);
		color: var(--sl-color-white);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.line {
		display: block;
	}
	.pr {
		color: var(--sl-color-gray-4);
	}
	/* On a phone a command never breaks mid word: it scrolls inside its box. */
	@media (max-width: 600px) {
		.cmd pre {
			white-space: pre;
			overflow-wrap: normal;
			overflow-x: auto;
			scrollbar-width: none;
		}
	}
</style>

<script>
	for (const box of document.querySelectorAll<HTMLElement>('[data-install]')) {
		const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-way]')];
		const cmds = [...box.querySelectorAll<HTMLElement>('[data-cmd]')];
		const show = (i: number, focus: boolean) => {
			tabs.forEach((t, k) => {
				t.setAttribute('aria-selected', String(k === i));
				t.tabIndex = k === i ? 0 : -1;
			});
			cmds.forEach((c, k) => (c.hidden = k !== i));
			if (focus) tabs[i].focus();
		};
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => show(i, false));
			t.addEventListener('keydown', (e) => {
				const last = tabs.length - 1;
				const next = { ArrowLeft: i ? i - 1 : last, ArrowRight: i < last ? i + 1 : 0, Home: 0, End: last }[e.key];
				if (next === undefined) return;
				e.preventDefault();
				show(next, true);
			});
		});
	}
</script>
