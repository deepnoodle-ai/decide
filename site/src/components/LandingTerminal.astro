---
// The landing page's terminal, as text, until the landing recording
// replaces it. A real run: Jev on the demo's billing change.
import TerminalFrame from './TerminalFrame.astro';

const command = 'git diff -- billing | decide run code-risk --fail-on flagged';
const transcript = 'Running code-risk on 2 files · typesafe jev-latest\n\nbilling/invoice.go\n  risk             no            98%\n  maintainability  ━━━━━━━━━━━━  4.0 of 4  Exceptionally clear and f…\n\nbilling/refund.go\n! risk             yes           94%\n! maintainability  ━━━━────────  1.4 of 4  Several unclear or fragil…\n\n✓ 2 answered  ! 1 flagged  200ms\nFlagged: billing/refund.go\nSaved as run 20261007-181621-4bb1\nSee these results again with: decide runs view 20261007-181621-4bb1\nExiting with code 2 because 1 item was flagged (--fail-on flagged)';
---

<TerminalFrame
	title="~/shop"
	label="decide judges two changed files, flags billing/refund.go, and exits with code 2"
	commands={[command]}
	transcript={transcript}
	cols={69}
>
	<pre set:html={'<span class="t-p">$</span> git diff -- billing | decide run code-risk --fail-on flagged\n<span class="t-d">Running code-risk on 2 files · typesafe jev-latest</span>\n\n<span class="t-b">billing/invoice.go</span>\n  risk             <span class="t-g">no</span>            <span class="t-g">98%</span>\n  maintainability  <span class="t-g">━━━━━━━━━━━━</span>  <span class="t-g">4.0 of 4</span>  <span class="t-d">Exceptionally clear and f…</span>\n\n<span class="t-b">billing/refund.go</span>\n<span class="t-r">!</span> risk             <span class="t-r">yes</span>           <span class="t-r">94%</span>\n<span class="t-r">!</span> maintainability  <span class="t-r">━━━━</span><span class="t-d">────────</span>  <span class="t-r">1.4 of 4</span>  <span class="t-d">Several unclear or fragil…</span>\n\n<span class="t-g">✓ 2 answered</span>  <span class="t-r">! 1 flagged</span>  <span class="t-d">200ms</span>\n<span class="t-d">Flagged:</span> billing/refund.go\n<span class="t-d">Saved as run</span> 20261007-181621-4bb1\n<span class="t-d">See these results again with:</span> decide runs view 20261007-181621-4bb1\n<span class="t-d">Exiting with code 2 because 1 item was flagged (--fail-on flagged)</span>\n<span class="t-p">$</span> <span class="cursor"> </span>'} />
</TerminalFrame>
