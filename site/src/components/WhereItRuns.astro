---
// "The small calls inside your automations.": four places a script makes
// the same call on every item. Each is one link card: how often (mono), what
// you do (the title), one line, the command on a dark strip, and the guide
// that sets it up. Two by two on desktop, so each has room to be read; one
// column below 760px. The whole card is the link.
const cells = [
	{
		k: 'every pull request',
		title: 'Gate the merge',
		line: 'A flagged change exits 2, and the check waits for someone to look.',
		cmd: 'git diff main | decide run code-risk --fail-on flagged',
		href: '/recipes/#run-decide-in-github-actions',
		link: 'Run it in GitHub Actions',
	},
	{
		k: 'every command',
		title: "Check an agent's commands",
		line: 'Each shell command an agent wants to run is judged before it runs.',
		cmd: 'echo "$CMD" | decide run command-risk --fail-on flagged',
		href: '/tutorials/check-agent-commands/',
		link: 'Check agent commands',
	},
	{
		k: 'every new ticket',
		title: 'Route the queue',
		line: 'Each ticket is sorted into a queue for the people who work it.',
		cmd: 'decide run ticket-routing tickets.jsonl --field body',
		href: '/recipes/#route-new-issues-to-a-queue',
		link: 'Route new issues',
	},
	{
		k: 'every function',
		title: 'Rank a codebase',
		line: 'Each function is scored for security mistakes, so you read the riskiest first.',
		cmd: 'decide run security src',
		href: '/tutorials/find-security-bugs/',
		link: 'Find security bugs',
	},
];
---

<div class="where">
	{
		cells.map((c) => (
			<a class="cell" href={c.href}>
				<p class="k">{c.k}</p>
				<h3>{c.title}</h3>
				<p class="line">{c.line}</p>
				<code>
					<span class="pr">$ </span>
					{c.cmd}
				</code>
				<span class="go">{c.link} →</span>
			</a>
		))
	}
</div>

<style>
	.where {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin-top: 48px;
		text-align: left;
	}
	.cell {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 28px 28px 26px;
		border: 1px solid var(--sl-color-hairline);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s,
			background-color 0.15s;
	}
	.cell:hover {
		border-color: var(--sl-color-gray-4);
		background: var(--sl-color-gray-7);
	}
	.k {
		margin: 0;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
	h3 {
		margin: 10px 0 0;
		font-size: 24px;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.line {
		flex: 1;
		max-width: 44ch;
		margin: 10px 0 0;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	/* The command, on a dark strip in both themes like every terminal. */
	code {
		display: block;
		margin-top: 22px;
		padding: 11px 14px;
		overflow-x: auto;
		background: var(--term-bg);
		border: 1px solid var(--term-border);
		border-radius: 0;
		font: 400 12.5px/1.5 var(--sl-font-mono);
		color: var(--term-fg);
		white-space: nowrap;
		scrollbar-width: none;
	}
	.pr {
		color: var(--term-muted);
	}
	.go {
		margin-top: 16px;
		font: 500 14px/1.4 var(--sl-font);
		color: var(--sl-color-white);
	}
	.cell:hover .go {
		text-decoration: underline;
		text-underline-offset: 0.22em;
	}
	@media (max-width: 760px) {
		.where {
			grid-template-columns: minmax(0, 1fr);
		}
		.cell {
			padding: 22px 20px;
		}
		h3 {
			font-size: 21px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cell {
			transition: none;
		}
	}
</style>
