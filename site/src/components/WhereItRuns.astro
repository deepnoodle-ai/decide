---
// "The small calls inside your automations.": six places a script makes
// the same call on every item. Each is one link card with three things to
// read: how often (mono) with a chip for what it reads, what you do (the
// title, with an arrow), and the command on a dark strip. A sentence and a
// named guide link were here too and made each card five lines to scan;
// the title and command carry it. Two columns on desktop; one below
// 760px. The whole card is the link.
//
// Commands are colored by hand with the code theme's colors: the template
// in the keyword color, flags and pipes quieter. No verdict colors.
const t = (name: string) => `<span class="t">${name}</span>`;
const f = (flag: string) => `<span class="f">${flag}</span>`;
const d = (pre: string) => `<span class="d">${pre}</span>`;

const cells = [
	{
		k: 'every pull request',
		reads: 'diff',
		title: 'Gate the merge',
		cmd: `${d('git diff main |')} decide run ${t('code-risk')} ${f('--fail-on flagged')}`,
		href: '/recipes/#run-decide-in-github-actions',
	},
	{
		k: 'every command',
		reads: 'text',
		title: "Check an agent's commands",
		cmd: `${d('echo "$CMD" |')} decide run ${t('command-risk')} ${f('--fail-on flagged')}`,
		href: '/tutorials/check-agent-commands/',
	},
	{
		k: 'every new ticket',
		reads: 'text',
		title: 'Route the queue',
		cmd: `decide run ${t('ticket-routing')} tickets.jsonl ${f('--field body')}`,
		href: '/recipes/#route-new-issues-to-a-queue',
	},
	{
		k: 'every function',
		reads: 'code',
		title: 'Rank a codebase',
		cmd: `decide run ${t('security')} src`,
		href: '/tutorials/find-security-bugs/',
	},
	{
		k: 'every receipt',
		reads: 'image',
		title: 'Read the photo',
		cmd: `decide run ${t('receipt-quality')} receipts/`,
		href: '/reference/templates/#receipt-quality',
	},
	{
		k: 'every invoice',
		reads: 'pdf',
		title: 'Check the PDF',
		cmd: `decide run ${t('invoice-check')} invoices/`,
		href: '/reference/templates/#invoice-check',
	},
];
---

<div class="where">
	{
		cells.map((c) => (
			<a class="cell" href={c.href}>
				<p class="k">
					{c.k}
					<span class="reads">{c.reads}</span>
				</p>
				<h3>
					{c.title}
					<span class="arrow" aria-hidden="true">→</span>
				</h3>
				<code>
					<span class="pr">$ </span>
					<Fragment set:html={c.cmd} />
				</code>
			</a>
		))
	}
</div>

<style>
	.where {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin-top: 48px;
		text-align: left;
	}
	.cell {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 24px 26px 26px;
		border: 1px solid var(--sl-color-hairline);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s,
			background-color 0.15s;
	}
	.cell:hover {
		border-color: var(--sl-color-gray-4);
		background: var(--sl-color-gray-7);
	}
	.k {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin: 0;
		font: 400 12.5px/1.4 var(--sl-font-mono);
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
	/* What the call reads, as a chip at the card's top right. */
	.reads {
		padding: 2px 8px;
		border: 1px solid var(--sl-color-gray-4);
		font-size: 11.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-white);
	}
	h3 {
		margin: 10px 0 0;
		font-size: 24px;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	/* The command, on a dark strip in both themes like every terminal. */
	code {
		display: block;
		margin-top: 18px;
		padding: 11px 14px;
		overflow-x: auto;
		background: var(--term-bg);
		border: 1px solid var(--term-border);
		border-radius: 0;
		font: 400 12.5px/1.5 var(--sl-font-mono);
		color: var(--term-fg);
		white-space: nowrap;
		scrollbar-width: none;
	}
	.pr,
	code :global(.d) {
		color: var(--term-muted);
	}
	code :global(.t) {
		font-weight: 700;
		color: #c69cf4;
	}
	code :global(.f) {
		color: #d7b98e;
	}
	/* The whole card is the link; the arrow after the title says so. */
	.arrow {
		display: inline-block;
		margin-left: 6px;
		color: var(--sl-color-gray-4);
		transition:
			transform 0.15s,
			color 0.15s;
	}
	.cell:hover .arrow {
		transform: translateX(3px);
		color: var(--sl-color-white);
	}
	@media (max-width: 760px) {
		.where {
			grid-template-columns: minmax(0, 1fr);
		}
		.cell {
			padding: 22px 20px;
		}
		h3 {
			font-size: 21px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cell,
		.arrow {
			transition: none;
		}
	}
</style>
